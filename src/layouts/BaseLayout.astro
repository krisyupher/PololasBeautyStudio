---
import '@fontsource-variable/montserrat';
import '@fontsource/great-vibes';
import '../styles/global.css';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrderDrawer from '../components/OrderDrawer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import UiIcon from '../components/icons/UiIcon.astro';
import { getServices, toCatalogEntries } from '../lib/catalog';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Pre-fills WhatsApp links with the treatment the visitor is looking at. */
  whatsappTopic?: string;
}

const { title, description, jsonLd, noindex, whatsappTopic } = Astro.props;

// Slim catalog for the order list in the browser. "<" is escaped so data can never close the tag.
const catalogJson = JSON.stringify(toCatalogEntries(await getServices())).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#8e2a8e" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <OrderDrawer />
    <MobileBar topic={whatsappTopic} />
    <WhatsAppFab topic={whatsappTopic} />

    <div class="toast" data-toast hidden>
      <UiIcon name="check" />
      <span data-toast-text></span>
      <button type="button" class="toast__action" data-open-order>
        Ver pedido
      </button>
    </div>
    <div class="visually-hidden" aria-live="polite" data-announcer></div>

    <script type="application/json" id="catalog-data" set:html={catalogJson} />
    <script>
      import '../scripts/order-ui';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--mobile-bar-h) + var(--space-3));
    z-index: 35;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: max-content;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-plum-900);
    color: var(--color-white);
    font-size: var(--text-sm);
    box-shadow: var(--shadow-lg);
    transform: translateX(-50%);
  }

  .toast :global(svg) {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-lilac-200);
  }

  .toast__action {
    flex: none;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .toast__action:hover {
    background: rgb(255 255 255 / 0.12);
  }

  @media (min-width: 48rem) {
    .toast {
      bottom: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .toast:not([hidden]) {
      animation: toast-in 0.3s var(--ease-out);
    }
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 12px);
    }
  }
</style>
