---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddToOrderButton from '../../components/AddToOrderButton.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IconCircle from '../../components/IconCircle.astro';
import Petals from '../../components/Petals.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import TwoToneTitle from '../../components/TwoToneTitle.astro';
import ValueBadges from '../../components/ValueBadges.astro';
import UiIcon from '../../components/icons/UiIcon.astro';
import { getCategories, getServices, type Category, type Service } from '../../lib/catalog';
import { MODALITY_LABELS } from '../../lib/constants';
import { formatPrice } from '../../lib/format';
import { getCategoryImage, getServiceImage } from '../../lib/images';
import { catalogUrl, serviceUrl, withBase } from '../../lib/paths';
import { breadcrumbJsonLd, serviceJsonLd } from '../../lib/schema';
import { buildInquiryMessage, buildWhatsAppUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const [categories, services] = await Promise.all([getCategories(), getServices()]);
  return services.map((service) => {
    const category = categories.find((item) => item.id === service.category);
    if (!category) {
      throw new Error(`Service "${service.id}" uses unknown category "${service.category}"`);
    }
    const related = services.filter(
      (item) => item.category === service.category && item.id !== service.id,
    );
    return { params: { id: service.id }, props: { service, category, related } };
  });
}

interface Props {
  service: Service;
  category: Category;
  related: Service[];
}

const { service, category, related } = Astro.props;
const whatsappUrl = buildWhatsAppUrl(buildInquiryMessage(service.name));
const moodImage = getCategoryImage(category.id);
const serviceImage = getServiceImage(service.id);
const crumbs = [
  { label: 'Inicio', href: withBase('/') },
  { label: 'Catálogo', href: catalogUrl() },
  { label: category.name, href: catalogUrl({ cat: category.id }) },
  { label: service.name },
];
---

<BaseLayout
  title={service.name}
  description={`${service.summary} ${category.name} en Modelia, Bogotá, ${service.modalities.map((m) => MODALITY_LABELS[m].toLowerCase()).join(' o ')}.`}
  whatsappTopic={service.name}
  closing={category.closing}
  jsonLd={[
    serviceJsonLd(service, category),
    breadcrumbJsonLd([
      { name: 'Inicio', path: withBase('/') },
      { name: 'Catálogo', path: withBase('/catalogo/') },
      { name: service.name, path: serviceUrl(service.id) },
    ]),
  ]}
>
  <section class="detail-hero petal-host">
    <Petals position="top-right" size="md" />
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="detail-hero__grid">
        <div class="detail-hero__copy">
          <p class="eyebrow">{category.name}</p>
          <h1 class="detail__title">{service.name}</h1>
          <p class="lead">{service.summary}</p>
          <ul class="detail__meta" role="list" aria-label="Modalidades">
            {service.modalities.map((modality) => (
              <li class="pill">{MODALITY_LABELS[modality]}</li>
            ))}
            {service.requiresAssessment && <li class="pill pill--outline">Valoración previa</li>}
          </ul>
          <p class="detail__price">
            {formatPrice(service.price)}
            {service.duration && <span> · Duración aproximada: {service.duration}</span>}
          </p>
          <div class="detail__actions">
            <AddToOrderButton id={service.id} name={service.name} />
            <a
              class="btn btn--whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <UiIcon name="whatsapp" />
              Preguntar por WhatsApp
            </a>
          </div>
        </div>

        <!-- Category mood photo, the treatment photo as an inset, and its icon. Decorative. -->
        <div class="detail-visual">
          {moodImage && (
            <div class="detail-visual__mood">
              <Image src={moodImage} alt="" loading="lazy" class="detail-visual__mood-image" />
            </div>
          )}
          {serviceImage && (
            <div class="detail-visual__inset">
              <Image src={serviceImage} alt="" loading="lazy" class="detail-visual__inset-image" />
            </div>
          )}
          <IconCircle line={service.icon} size="xl" class="detail-visual__icon" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail-body">
      <div class="prose">
        <h2>Sobre el tratamiento</h2>
        <p>{service.description}</p>
        <h2>Beneficios</h2>
        <ul class="benefits" role="list">
          {service.benefits.map((benefit) => (
            <li>
              <span class="benefits__check" aria-hidden="true">
                <UiIcon name="check" strokeWidth={2.2} />
              </span>
              {benefit}
            </li>
          ))}
        </ul>
      </div>

      <aside class="detail-aside" aria-label="Información para tu cita">
        {service.requiresAssessment && (
          <div class="callout glass">
            <h2>Antes de tu procedimiento</h2>
            <p>
              Requiere valoración previa para confirmar que el tratamiento es adecuado para ti. Los
              resultados varían según cada persona.
            </p>
          </div>
        )}
        <div class="callout callout--soft">
          <h2>¿Cómo lo pido?</h2>
          <ol>
            <li>Agrégalo a tu pedido.</li>
            <li>Elige si lo quieres en el estudio o a domicilio.</li>
            <li>Envíanos el pedido por WhatsApp y te confirmamos precio y disponibilidad.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft" aria-labelledby="relacionados-title">
      <div class="container">
        <header class="section__header">
          <TwoToneTitle
            id="relacionados-title"
            lines={['También te puede', 'interesar']}
            size="md"
          />
        </header>
        <ul class="card-grid" role="list">
          {related.map((item) => (
            <li>
              <ServiceCard service={item} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- The category's value badges; its closing line rides on the footer wave below. -->
  <section
    class="detail-values"
    aria-label={`Lo que nos distingue en ${category.name.toLowerCase()}`}
  >
    <div class="container">
      <ValueBadges values={category.values} />
    </div>
  </section>
</BaseLayout>

<style>
  .detail-hero {
    padding-block: var(--space-6) var(--space-12);
    background: var(--gradient-soft);
  }

  .detail-hero__grid {
    display: grid;
    align-items: center;
    gap: var(--space-10);
    margin-top: var(--space-6);
  }

  .detail-hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  /* Long single words ("BIOESTIMULADORES") must fit at 320px without clipping (WCAG 1.4.10). */
  .detail__title {
    font-size: clamp(1.5rem, 7.8vw, 4rem);
    overflow-wrap: anywhere;
    hyphens: auto;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .detail__price {
    color: var(--color-heading);
    font-weight: 600;
  }

  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ---------- Visual ---------- */
  .detail-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
    padding-bottom: var(--space-8);
  }

  .detail-visual__mood {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 45% 45% var(--radius-xl) var(--radius-xl);
  }

  .detail-visual__mood :global(.detail-visual__mood-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .detail-visual__inset {
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-4));
    width: min(58%, 13.5rem);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 4px solid var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .detail-visual__inset :global(.detail-visual__inset-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-visual :global(.detail-visual__icon) {
    position: absolute;
    top: var(--space-6);
    right: calc(-1 * var(--space-2));
    border: 4px solid var(--color-white);
  }

  /* ---------- Body ---------- */
  .detail-body {
    display: grid;
    gap: var(--space-10);
  }

  .benefits {
    display: grid;
    gap: var(--space-3);
    padding: 0;
  }

  .benefits li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .benefits__check {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gradient-icon);
    background-color: var(--color-icon-bg);
    color: var(--color-accent);
  }

  .benefits__check :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .detail-aside {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .callout {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    border-left: 4px solid var(--color-accent-bright);
  }

  .callout--soft {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-petal-deep);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
  }

  .callout h2 {
    font-size: var(--text-base);
    font-weight: 800;
    text-transform: uppercase;
  }

  .callout ol {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }

  .detail-values {
    padding-block: var(--space-12) calc(var(--wave-h) + var(--space-6));
  }

  @media (min-width: 64rem) {
    .detail-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .detail-body {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .detail-hero__copy > * {
      animation: fade-up var(--duration-reveal) var(--ease-out) both;
    }

    .detail-hero__copy > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .detail-hero__copy > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .detail-hero__copy > :nth-child(n + 4) {
      animation-delay: 0.24s;
    }

    .detail-visual__mood :global(.detail-visual__mood-image) {
      animation: settle 1.4s var(--ease-out) both;
    }

    .detail-visual__inset,
    .detail-visual :global(.detail-visual__icon) {
      animation: pop-in 0.8s var(--ease-out) 0.35s both;
    }
  }
</style>
