---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconCircle from '../components/IconCircle.astro';
import Petals from '../components/Petals.astro';
import ScriptAccent from '../components/ScriptAccent.astro';
import TwoToneTitle from '../components/TwoToneTitle.astro';
import { catalogUrl, withBase } from '../lib/paths';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe. Explora nuestro catálogo de tratamientos."
  noindex
>
  <section class="section not-found petal-host">
    <Petals position="top-left" size="md" />
    <Petals position="bottom-right" size="lg" />
    <div class="container not-found__inner">
      <IconCircle line="lotus" size="xl" />
      <TwoToneTitle
        as="h1"
        lines={['Esta página', 'se fue a relajar']}
        size="lg"
        align="center"
        animate="load"
      />
      <ScriptAccent text="Respira, aquí te esperamos" lines={2} animate="none" />
      <p class="lead">No encontramos lo que buscabas, pero tenemos muchos tratamientos para ti.</p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={catalogUrl()}>
          Ver catálogo
        </a>
        <a class="btn btn--outline" href={withBase('/')}>
          Ir al inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-bottom: calc(var(--wave-h) + var(--space-12));
    background: var(--gradient-soft);
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
