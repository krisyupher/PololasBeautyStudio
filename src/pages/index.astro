---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Heart from '../components/Heart.astro';
import IconCircle from '../components/IconCircle.astro';
import Kicker from '../components/Kicker.astro';
import Petals from '../components/Petals.astro';
import ScriptAccent from '../components/ScriptAccent.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TwoToneTitle from '../components/TwoToneTitle.astro';
import ValueBadges from '../components/ValueBadges.astro';
import WaveBand from '../components/WaveBand.astro';
import UiIcon from '../components/icons/UiIcon.astro';
import type { UiIconName } from '../components/icons/ui-icons';
import { business } from '../data/business';
import { faqs } from '../data/faq';
import { testimonials } from '../data/testimonials';
import { getCategories, getServices } from '../lib/catalog';
import type { IconName } from '../lib/constants';
import { getCategoryImage, getHeroImage, getHighlightImage, getThanksImage } from '../lib/images';
import { catalogUrl, serviceUrl } from '../lib/paths';
import { businessJsonLd } from '../lib/schema';
import { buildInquiryMessage, buildWhatsAppUrl } from '../lib/whatsapp';

const [categories, services] = await Promise.all([getCategories(), getServices()]);
const serviceIds = new Set(services.map((service) => service.id));
const heroImage = getHeroImage();
const thanksImage = getThanksImage();
const whatsappUrl = buildWhatsAppUrl(buildInquiryMessage());

// The owner's Instagram highlight covers (only when the treatment exists), then one circle per
// home section. A missing cover falls back to its line icon.
const highlights = [
  ...[
    { cover: 'toxina', label: 'Toxina', service: 'toxina-botulinica', icon: 'face' },
    { cover: 'labios', label: 'Labios', service: 'acido-hialuronico', icon: 'lips' },
    { cover: 'rino', label: 'Rino', service: 'acido-hialuronico', icon: 'nose' },
    { cover: 'bio', label: 'Bioestimuladores', service: 'bioestimuladores', icon: 'profile' },
  ]
    .filter((item) => serviceIds.has(item.service))
    .map((item) => ({
      label: item.label,
      href: serviceUrl(item.service),
      image: getHighlightImage(item.cover),
      icon: item.icon as IconName,
    })),
  ...categories.map((category) => ({
    label: category.shortName,
    href: `#${category.id}`,
    image: undefined,
    icon: category.icon,
  })),
];

// One showcase per category, mirroring the catalog pages; the photo side alternates.
const showcases = categories
  .map((category, index) => ({
    category,
    services: services.filter((service) => service.category === category.id),
    image: getCategoryImage(category.id),
    photoSide: index % 2 === 0 ? 'end' : 'start',
  }))
  .filter((showcase) => showcase.services.length > 0);

const pillars: { line?: IconName; ui?: UiIconName; title: string; text: string }[] = [
  { line: 'lotus', title: 'Belleza', text: 'que te inspira' },
  { ui: 'heart', title: 'Bienestar', text: 'que te equilibra' },
  { ui: 'sparkles', title: 'Confianza', text: 'que te acompaña' },
];

const steps = [
  {
    title: 'Elige',
    text: 'Explora el catálogo y agrega a tu pedido los tratamientos que te interesan.',
  },
  {
    title: 'Personaliza',
    text: 'Indica si los quieres en el estudio o a domicilio, y para cuántas personas.',
  },
  {
    title: 'Confirma por WhatsApp',
    text: 'Envíanos tu pedido. Una asesora te confirma precio, disponibilidad y detalles.',
  },
];

// Treatments offered at home, computed from the data and joined as a Spanish list
// ("A, B y C"; Intl also handles "e" before words starting with "i").
const homeServices = services.filter((service) => service.modalities.includes('domicilio'));
let nextHomeService = 0;
const homeServiceParts = new Intl.ListFormat('es', { type: 'conjunction' })
  .formatToParts(homeServices.map((service) => service.name))
  .map((part) => {
    if (part.type !== 'element') return { text: part.value };
    const service = homeServices[nextHomeService++];
    return { text: part.value, href: service ? serviceUrl(service.id) : undefined };
  });
---

<BaseLayout
  title={business.name}
  description={`${business.description} ${business.slogan}`}
  jsonLd={[businessJsonLd(categories, services)]}
>
  <!-- Hero: the catalog cover -->
  <section class="hero petal-host" aria-labelledby="hero-title">
    <Petals position="bottom-left" size="lg" />
    <Petals position="top-right" size="sm" class="hero__petals-top" />
    {heroImage && (
      <div class="hero__media">
        <Image src={heroImage} alt="" loading="eager" fetchpriority="high" class="hero__photo" />
      </div>
    )}
    <div class="container hero__inner">
      <div class="hero__copy">
        <TwoToneTitle
          class="hero__title"
          as="h1"
          id="hero-title"
          size="xl"
          lines={['Tu bienestar', 'en buenas manos']}
          animate="load"
        />
        <ScriptAccent
          text="Más que servicios, experiencias para ti"
          size="lg"
          animate="load"
          class="hero__script"
        />
        <ul class="pillars" role="list">
          {pillars.map((pillar) => (
            <li class="pillar">
              <IconCircle line={pillar.line} ui={pillar.ui} size="md" />
              <span class="pillar__title">{pillar.title}</span>{' '}
              <span class="pillar__text">{pillar.text}</span>
            </li>
          ))}
        </ul>
        <p class="hero__lead">
          Estética facial, bienestar y estética corporal en Modelia, Bogotá. Arma tu pedido y
          confírmalo por WhatsApp: en el estudio o, en algunos servicios, a domicilio.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={catalogUrl()}>
            Ver catálogo
            <UiIcon name="arrow-right" />
          </a>
          <a class="btn btn--outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <UiIcon name="whatsapp" />
            Escríbenos
          </a>
        </div>
        <p class="spaced hero__tagline">Cuida de ti, relájate y realza tu belleza natural</p>
        <span class="rule hero__rule" aria-hidden="true"></span>
      </div>
    </div>
    <WaveBand text="Belleza · Bienestar · Confianza · En un solo lugar" class="hero__wave" />
  </section>

  <!-- Highlights: Instagram-style circles -->
  <section class="highlights" aria-labelledby="explora-title">
    <div class="container">
      <h2 id="explora-title" class="visually-hidden">
        Explora por tratamiento
      </h2>
      <ul class="highlights__list" role="list">
        {highlights.map((item) => (
          <li>
            <a class="highlight" href={item.href}>
              <span class="highlight__ring">
                <span class="highlight__circle">
                  {item.image ? (
                    <Image
                      src={item.image}
                      alt=""
                      width={96}
                      densities={[1, 2]}
                      class="highlight__image"
                    />
                  ) : (
                    <IconCircle line={item.icon} size="xl" class="highlight__icon" />
                  )}
                </span>
              </span>
              <span class="highlight__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How to order -->
  <section class="section" id="como-pedir" aria-labelledby="como-pedir-title">
    <div class="container">
      <header class="section__header section__header--center">
        <p class="eyebrow">Fácil y sin compromiso</p>
        <TwoToneTitle id="como-pedir-title" lines={['Cómo', 'pedir']} size="lg" align="center" />
      </header>
      <ol class="steps" role="list">
        {steps.map((step, index) => (
          <li class="step reveal">
            <span class="step__number" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="step__title">
              <span class="visually-hidden">Paso {index + 1}: </span>
              {step.title}
            </h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="steps__actions">
        <a class="btn btn--primary" href={catalogUrl()}>
          Ver catálogo
          <UiIcon name="arrow-right" />
        </a>
        <a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <UiIcon name="whatsapp" />
          Escríbenos
        </a>
      </div>
    </div>
  </section>

  <!-- One showcase per category: the catalog's pages 2 to 4 -->
  {showcases.map(({ category, services: items, image, photoSide }) => (
    <section
      id={category.id}
      class:list={['showcase', 'petal-host', `showcase--photo-${photoSide}`]}
      aria-labelledby={`${category.id}-title`}
    >
      <Petals position={photoSide === 'end' ? 'top-right' : 'top-left'} size="md" />
      <Petals position={photoSide === 'end' ? 'bottom-left' : 'bottom-right'} size="md" />
      <div class="container showcase__grid">
        <header class="showcase__head">
          <Kicker decorative class="showcase__kicker" />
          <TwoToneTitle id={`${category.id}-title`} lines={category.titleLines} size="lg" />
          <p class="showcase__subtitle">{category.description}</p>
        </header>

        <div class="showcase__media">
          <div class="showcase__sticky">
            {image && (
              <div class="showcase__photo-frame">
                <Image src={image} alt="" loading="lazy" class="showcase__photo" />
              </div>
            )}
            <ScriptAccent text={category.script} class="showcase__script" />
            <p class="spaced showcase__note">{category.note}</p>
            <span class="rule showcase__rule" aria-hidden="true" />
          </div>
        </div>

        <ul class="showcase__list" role="list">
          {items.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))}
        </ul>
      </div>
      <div class="container">
        <ValueBadges values={category.values} class="showcase__values" />
      </div>
      <WaveBand
        text={category.closing}
        align={photoSide === 'end' ? 'start' : 'end'}
        flip={photoSide === 'end'}
      />
    </section>
  ))}

  <!-- Studio or home -->
  <section
    class="section section--soft petal-host"
    id="modalidades"
    aria-labelledby="modalidades-title"
  >
    <Petals position="bottom-right" size="md" />
    <div class="container">
      <header class="section__header section__header--center">
        <p class="eyebrow">Tú eliges dónde</p>
        <TwoToneTitle
          id="modalidades-title"
          lines={['En el estudio', 'o en tu casa']}
          size="lg"
          align="center"
        />
      </header>
      <div class="modes">
        <article class="mode glass reveal">
          <IconCircle ui="studio" size="lg" />
          <h3>En el estudio</h3>
          <p>
            Te esperamos en nuestro estudio en {business.location.neighborhood},{' '}
            {business.location.city}: un espacio tranquilo para desconectarte y dejarte cuidar.
          </p>
          <a class="btn btn--outline btn--sm" href={catalogUrl({ modo: 'estudio' })}>
            Tratamientos en el estudio
          </a>
        </article>
        <article class="mode glass reveal">
          <IconCircle ui="home" size="lg" />
          <h3>A domicilio</h3>
          <p>{business.homeServiceNote}</p>
          {homeServiceParts.length > 0 && (
            <p class="mode__services">
              Disponibles a domicilio:{' '}
              {homeServiceParts.map((part) =>
                part.href ? <a href={part.href}>{part.text}</a> : part.text,
              )}
              .
            </p>
          )}
          <a class="btn btn--outline btn--sm" href={catalogUrl({ modo: 'domicilio' })}>
            Tratamientos a domicilio
          </a>
        </article>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section" aria-labelledby="testimonios-title">
      <div class="container">
        <header class="section__header section__header--center">
          <p class="eyebrow">Lo que dicen nuestras clientas</p>
          <TwoToneTitle
            id="testimonios-title"
            lines={['Clientas', 'felices']}
            size="lg"
            align="center"
          />
        </header>
        <ul class="testimonials" role="list">
          {testimonials.map((item) => (
            <li>
              <figure class="testimonial glass">
                <blockquote>
                  <p>“{item.quote}”</p>
                </blockquote>
                <figcaption>{item.author}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section" id="preguntas" aria-labelledby="preguntas-title">
    <div class="container faq-layout">
      <header class="faq-layout__head">
        <p class="eyebrow">Resolvemos tus dudas</p>
        <TwoToneTitle id="preguntas-title" lines={['Preguntas', 'frecuentes']} size="lg" />
        <p class="faq-layout__lead">
          ¿No encuentras tu respuesta?{' '}
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Escríbenos por WhatsApp
          </a>
          .
        </p>
      </header>
      <div class="faq">
        {faqs.map((faq) => (
          <details class="faq__item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- "Gracias" and contact: the catalog's closing page -->
  <section class="thanks petal-host" id="contacto" aria-labelledby="contacto-title">
    <Petals position="top-left" size="md" />
    <Petals position="bottom-left" size="lg" />
    {thanksImage && (
      <div class="thanks__media">
        <Image src={thanksImage} alt="" loading="lazy" class="thanks__photo" />
      </div>
    )}
    <div class="container thanks__inner">
      <div class="thanks__copy">
        <Kicker decorative />
        <TwoToneTitle
          id="contacto-title"
          lines={['Por ser parte', 'de esta historia']}
          size="md"
          class="thanks__title"
        >
          <span slot="before" class="thanks__script">
            Gracias
            <Heart class="thanks__heart" />
          </span>
        </TwoToneTitle>
        <p class="thanks__text">
          En Pololas creemos que el cuidado personal es una forma de amor propio, y nos inspira
          acompañarte en cada paso hacia tu mejor versión.
        </p>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <ul class="contact-panel glass" role="list">
        <li>
          <a
            class="contact-panel__item"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconCircle ui="whatsapp" size="md" />
            <span class="contact-panel__label">Agenda tu cita</span>
            <span class="contact-panel__value">{business.whatsapp.display}</span>
            <span class="visually-hidden"> (WhatsApp)</span>
          </a>
        </li>
        <li>
          <a
            class="contact-panel__item"
            href={business.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconCircle ui="instagram" size="md" />
            <span class="contact-panel__label">Síguenos</span>
            <span class="contact-panel__value">{business.name}</span>
            <span class="visually-hidden"> (Instagram)</span>
          </a>
        </li>
        <li>
          <a
            class="contact-panel__item"
            href={business.location.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconCircle ui="pin" size="md" />
            <span class="contact-panel__label">Visítanos</span>
            <span class="contact-panel__value">
              {business.location.neighborhood}, {business.location.city}
            </span>
            <span class="visually-hidden"> (Google Maps)</span>
          </a>
        </li>
      </ul>

      <div class="thanks__more">
        <ul class="thanks__links" role="list">
          <li>
            <a href={business.social.facebook} target="_blank" rel="noopener noreferrer">
              <UiIcon name="facebook" />
              Facebook
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`}>
              <UiIcon name="mail" />
              {business.email}
            </a>
          </li>
        </ul>
        <p class="thanks__hours">
          <UiIcon name="clock" />
          {business.hoursNote}
        </p>
        <p class="thanks__disclaimer">
          Los procedimientos de estética facial los realiza un profesional de la salud, previa
          valoración. Los resultados varían según cada persona.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    background: var(--color-bg);
  }

  .hero__media {
    position: relative;
    height: clamp(13.5rem, 58vw, 22rem);
    overflow: hidden;
  }

  .hero__media :global(.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .hero__inner {
    position: relative;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-2) var(--space-10);
  }

  .hero :global(.hero__script) {
    margin-top: calc(-1 * var(--space-2));
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 32rem;
  }

  .pillar {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-1);
    padding-inline: var(--space-2);
    color: var(--color-heading);
    font-size: var(--text-2xs);
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .pillar + .pillar::before {
    content: '';
    position: absolute;
    inset: 4% auto 4% 0;
    width: 1px;
    background: linear-gradient(transparent, var(--color-rule) 15% 85%, transparent);
  }

  .pillar :global(.icon-circle) {
    margin-bottom: var(--space-2);
  }

  .pillar__title {
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .pillar__text {
    font-weight: 500;
  }

  .hero__lead {
    max-width: 34rem;
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__tagline {
    max-width: 24em;
    margin-top: var(--space-2);
  }

  .hero__rule {
    margin-top: calc(-1 * var(--space-2));
  }

  .hero :global(.hero__petals-top) {
    display: none;
  }

  /* Phones and tablets: a shorter banner, and the lead and buttons right after the script line,
     so "Ver catálogo" is above the fold; the pillars and tagline follow. Desktop keeps the
     catalog cover order. None of the reordered items is focusable, so focus order is unchanged. */
  @media (max-width: 63.99rem) {
    .hero__media {
      height: clamp(11rem, 44vw, 22rem);
    }

    .hero__media :global(.hero__photo) {
      object-position: 50% 22%;
    }

    .hero__lead {
      font-size: var(--text-base);
    }

    .pillars {
      order: 1;
      margin-top: var(--space-3);
    }

    .hero__tagline {
      order: 2;
    }

    .hero__rule {
      order: 3;
    }
  }

  @media (min-width: 64rem) {
    .hero__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: min(44vw, 38rem);
      height: auto;
    }

    .hero__media :global(.hero__photo) {
      object-position: 50% 12%;
      mask-image:
        linear-gradient(to right, transparent 0, #000 38%),
        linear-gradient(to bottom, #000 72%, transparent 94%);
      mask-composite: intersect;
    }

    .hero__copy {
      max-width: min(38rem, 56%);
      padding-block: var(--space-12) var(--space-12);
    }

    .hero :global(.hero__petals-top) {
      display: block;
    }
  }

  /* The wave overlaps the bottom of the photo, as on the cover. */
  .hero :global(.hero__wave) {
    position: relative;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(.hero__photo) {
      animation: settle 1.4s var(--ease-out) both;
    }

    .pillar,
    .hero__lead,
    .hero__actions > *,
    .hero__tagline,
    .hero__rule {
      animation: fade-up var(--duration-reveal) var(--ease-out) both;
    }

    .pillar:nth-child(1) {
      animation-delay: 0.6s;
    }

    .pillar:nth-child(2) {
      animation-delay: 0.72s;
    }

    .pillar:nth-child(3) {
      animation-delay: 0.84s;
    }

    .hero__lead {
      animation-delay: 0.9s;
    }

    .hero__actions > :nth-child(1) {
      animation-delay: 1s;
    }

    .hero__actions > :nth-child(2) {
      animation-delay: 1.12s;
    }

    .hero__tagline,
    .hero__rule {
      animation-delay: 1.25s;
    }
  }

  /* ---------- Highlights (Instagram-style circles) ---------- */
  .highlights {
    padding-block: var(--space-8) var(--space-6);
  }

  .highlights__list {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding: var(--space-2) var(--space-1);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .highlights__list li {
    flex: none;
    scroll-snap-align: start;
  }

  .highlight {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: 6.5rem;
    color: var(--color-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .highlight:hover {
    color: var(--color-accent);
  }

  /* Thin gradient ring; a brighter copy fades in on hover. */
  .highlight__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--gradient-brand);
    transition: transform 0.35s var(--ease-out);
  }

  .highlight__ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      var(--color-accent-bright),
      var(--color-heart),
      var(--color-wave-pink)
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .highlight__circle {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    overflow: hidden;
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-white);
  }

  .highlight__circle :global(.highlight__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .highlight__circle :global(.highlight__icon) {
    width: 100%;
    height: 100%;
    background: #f6c7f3;
    box-shadow: none;
  }

  .highlight:hover .highlight__ring::before,
  .highlight:focus-visible .highlight__ring::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .highlight:hover .highlight__ring,
    .highlight:focus-visible .highlight__ring {
      transform: scale(1.07);
    }
  }

  @media (min-width: 64rem) {
    .highlights__list {
      justify-content: center;
    }
  }

  /* ---------- Category showcases ---------- */
  .showcase {
    padding-top: var(--space-section);
