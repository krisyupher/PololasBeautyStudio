---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IconCircle from '../../components/IconCircle.astro';
import Kicker from '../../components/Kicker.astro';
import Petals from '../../components/Petals.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import TwoToneTitle from '../../components/TwoToneTitle.astro';
import UiIcon from '../../components/icons/UiIcon.astro';
import { getCategories, getServices } from '../../lib/catalog';
import { LIMITS, MODALITIES, MODALITY_LABELS } from '../../lib/constants';
import { withBase } from '../../lib/paths';
import { breadcrumbJsonLd } from '../../lib/schema';
import { buildSearchText } from '../../lib/search';
import { buildInquiryMessage, buildWhatsAppUrl } from '../../lib/whatsapp';

const [categories, services] = await Promise.all([getCategories(), getServices()]);
const groups = categories
  .map((category) => ({
    category,
    services: services.filter((service) => service.category === category.id),
  }))
  .filter((group) => group.services.length > 0);
const whatsappUrl = buildWhatsAppUrl(
  buildInquiryMessage('un tratamiento que no encontré en el catálogo'),
);
---

<BaseLayout
  title="Catálogo de tratamientos"
  description="Estética facial, bienestar y cuidado personal, y estética corporal en Modelia, Bogotá, en el estudio o a domicilio. Arma tu pedido y confírmalo por WhatsApp."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Inicio', path: withBase('/') },
      { name: 'Catálogo', path: withBase('/catalogo/') },
    ]),
  ]}
>
  <section class="page-hero petal-host">
    <Petals position="top-right" size="md" />
    <Petals position="bottom-left" size="sm" />
    <div class="container page-hero__inner">
      <Breadcrumbs items={[{ label: 'Inicio', href: withBase('/') }, { label: 'Catálogo' }]} />
      <Kicker class="page-hero__kicker" />
      <TwoToneTitle as="h1" lines={['Catálogo de', 'tratamientos']} size="lg" animate="load" />
      <p class="lead">
        Busca y filtra por categoría o modalidad. Agrega a tu pedido lo que te interesa y envíanoslo
        por WhatsApp: te confirmamos precio, disponibilidad y detalles.
      </p>
    </div>
  </section>

  <div class="container catalog" data-catalog>
    <form
      class="catalog-filters"
      role="search"
      aria-label="Filtrar tratamientos"
      data-catalog-form
      data-needs-js
    >
      <div class="search-field">
        <label for="catalog-search" class="visually-hidden">
          Buscar tratamiento
        </label>
        <UiIcon name="search" />
        <input
          id="catalog-search"
          type="search"
          name="q"
          placeholder="Busca: toxina, labios, masaje…"
          maxlength={LIMITS.maxQuery}
          autocomplete="off"
          data-catalog-search
        />
      </div>
      <div class="chip-row" role="group" aria-label="Categoría">
        <button type="button" class="chip" data-filter-category="" aria-pressed="true">
          Todas
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class="chip"
            data-filter-category={category.id}
            aria-pressed="false"
          >
            {category.shortName}
          </button>
        ))}
      </div>
      <div class="chip-row" role="group" aria-label="Modalidad">
        <button type="button" class="chip" data-filter-modality="" aria-pressed="true">
          Cualquier lugar
        </button>
        {MODALITIES.map((modality) => (
          <button type="button" class="chip" data-filter-modality={modality} aria-pressed="false">
            {MODALITY_LABELS[modality]}
          </button>
        ))}
      </div>
    </form>

    <p class="catalog__count" aria-live="polite" data-results-count>
      {services.length} tratamientos
    </p>

    {groups.map(({ category, services: items }) => (
      <section
        class="catalog-group"
        aria-labelledby={`grupo-${category.id}`}
        data-category-group={category.id}
      >
        <header class="catalog-group__header">
          <IconCircle line={category.icon} size="lg" />
          <div class="catalog-group__text">
            <TwoToneTitle id={`grupo-${category.id}`} lines={category.titleLines} size="md" />
            <p>{category.description}</p>
          </div>
        </header>
        <ul class="card-grid" role="list">
          {items.map((service) => (
            <li
              data-service-card
              data-category={service.category}
              data-modalities={service.modalities.join(' ')}
              data-search={buildSearchText({
                name: service.name,
                summary: service.summary,
                tags: service.tags,
                categoryName: category.name,
              })}
            >
              <ServiceCard service={service} />
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="catalog-empty" data-catalog-empty hidden>
      <p class="catalog-empty__title">No encontramos tratamientos con esos filtros</p>
      <p>¿No encuentras lo que buscas? Escríbenos y te asesoramos.</p>
      <div class="catalog-empty__actions">
        <button type="button" class="btn btn--outline" data-reset-filters>
          Ver todos
        </button>
        <a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <UiIcon name="whatsapp" />
          Escríbenos
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/catalog-filters';
</script>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-10);
    background: var(--gradient-soft);
  }

  .page-hero__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .page-hero .lead {
    max-width: 44rem;
  }

  /* On phones the search field matters more than the decorative kicker. */
  @media (max-width: 47.99rem) {
    .page-hero :global(.page-hero__kicker) {
      display: none;
    }
  }

  .catalog {
    padding-block: var(--space-8) calc(var(--wave-h) + var(--space-12));
  }

  .catalog-filters {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .search-field {
    position: relative;
    max-width: 34rem;
  }

  .search-field :global(svg) {
    position: absolute;
    top: 50%;
    left: var(--space-5);
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-field input {
    width: 100%;
    min-height: 3.25rem;
    padding: var(--space-2) var(--space-5) var(--space-2) 3.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    box-shadow:
      0 0 0 1px rgb(255 36 137 / 0.06),
      var(--shadow-md);
  }

  .search-field input::placeholder {
    color: var(--color-text-muted);
  }

  .search-field input:focus-visible {
    outline-offset: 0;
    border-color: var(--color-primary);
  }

  .catalog__count {
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .catalog-group + .catalog-group {
    margin-top: var(--space-16);
  }

  .catalog-group__header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .catalog-group__text {
    display: grid;
    gap: var(--space-2);
  }

  .catalog-group__text p {
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .catalog-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .catalog-empty__title {
    color: var(--color-heading);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .catalog-empty__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  /* Desktop: a compact sticky bar (search and both chip groups on one wrapping row), so it never
     hides the control that has focus (WCAG 2.4.11); scroll-padding keeps focused cards clear of it. */
  @media (min-width: 64rem) {
    :global(html:has([data-catalog-form])) {
      scroll-padding-top: calc(var(--header-h) + 9rem);
    }

    .catalog-filters {
      position: sticky;
      top: var(--header-h);
      z-index: 20;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
      background: rgb(255 255 255 / 0.96);
    }

    .search-field {
      flex: 1 1 15rem;
      max-width: 24rem;
    }

    .search-field input {
      min-height: var(--tap-min);
      padding-right: var(--space-3);
      box-shadow: none;
    }

    .catalog-filters .chip-row {
      flex-wrap: wrap;
      overflow: visible;
      padding-block: 0;
    }

    .catalog-filters :global(.chip) {
      padding-inline: var(--space-3);
    }
  }
</style>
