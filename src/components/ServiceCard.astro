---
import ServiceMedia from './ServiceMedia.astro';
import AddToOrderButton from './AddToOrderButton.astro';
import { MODALITY_LABELS } from '../lib/constants';
import type { Service } from '../lib/catalog';
import { serviceUrl } from '../lib/paths';
import { formatPrice } from '../lib/format';

interface Props {
  service: Service;
  categoryName: string;
  headingLevel?: 'h2' | 'h3';
}

const { service, categoryName, headingLevel: Heading = 'h3' } = Astro.props;
const href = serviceUrl(service.id);
---

<article class="service-card">
  <a href={href} class="service-card__media" tabindex="-1" aria-hidden="true">
    <ServiceMedia id={service.id} name={service.name} icon={service.icon} />
  </a>
  <div class="service-card__body">
    <p class="service-card__category">{categoryName}</p>
    <Heading class="service-card__title">
      <a href={href}>{service.name}</a>
    </Heading>
    <p class="service-card__summary">{service.summary}</p>
    <ul class="service-card__meta" role="list" aria-label="Modalidades">
      {service.modalities.map((modality) => (
        <li class="pill">{MODALITY_LABELS[modality]}</li>
      ))}
      {service.requiresAssessment && <li class="pill pill--outline">Valoración previa</li>}
    </ul>
    <p class="service-card__price">{formatPrice(service.price)}</p>
    <div class="service-card__actions">
      <AddToOrderButton id={service.id} name={service.name} size="sm" />
      <a href={href} class="btn btn--ghost btn--sm">
        Ver detalle<span class="visually-hidden"> de {service.name}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .service-card__media {
    display: block;
  }

  .service-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .service-card__category {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .service-card__title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .service-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .service-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .service-card__price {
    color: var(--color-plum-900);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .service-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }
</style>
