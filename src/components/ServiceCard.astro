---
import { Image } from 'astro:assets';
import AddToOrderButton from './AddToOrderButton.astro';
import IconCircle from './IconCircle.astro';
import { MODALITY_LABELS } from '../lib/constants';
import type { Service } from '../lib/catalog';
import { formatPrice } from '../lib/format';
import { getServiceImage } from '../lib/images';
import { serviceUrl } from '../lib/paths';

/**
 * A treatment as the catalog's service row: rounded photo, then an icon circle, a thin pink
 * rule, the title and the summary; below, modalities, price and the order actions.
 * The card adapts to its own width (container queries), so it works in lists and grids.
 */
interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel: Heading = 'h3' } = Astro.props;
const href = serviceUrl(service.id);
const image = getServiceImage(service.id);
---

<article class="service-card reveal">
  <div class="service-card__main">
    <a href={href} class="service-card__photo" tabindex="-1" aria-hidden="true">
      {
        image ? (
          <Image src={image} alt="" loading="lazy" class="service-card__image" />
        ) : (
          <IconCircle line={service.icon} size="lg" class="service-card__fallback" />
        )
      }
    </a>
    <div class="service-card__head">
      <IconCircle line={service.icon} size="md" class="service-card__icon" />
      <span class="service-card__rule" aria-hidden="true"></span>
      <div class="service-card__text">
        <Heading class="service-card__title">
          <a href={href}>{service.name}</a>
        </Heading>
        <p class="service-card__summary">{service.summary}</p>
      </div>
    </div>
  </div>
  <div class="service-card__foot">
    <div class="service-card__info">
      <ul class="service-card__meta" role="list" aria-label="Modalidades">
        {service.modalities.map((modality) => <li class="pill">{MODALITY_LABELS[modality]}</li>)}
        {service.requiresAssessment && <li class="pill pill--outline">Valoración previa</li>}
      </ul>
      <p class="service-card__price">{formatPrice(service.price)}</p>
    </div>
    <div class="service-card__actions">
      <AddToOrderButton id={service.id} name={service.name} size="sm" />
      <a href={href} class="btn btn--ghost btn--sm">
        Ver detalle<span class="visually-hidden"> de {service.name}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .service-card {
    container-type: inline-size;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: var(--radius-lg);
    background: var(--color-surface-glass);
    box-shadow:
      0 0 0 1px rgb(255 36 137 / 0.1),
      var(--shadow-md);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  /* Narrow cards (phones): photo and text side by side; the icon circle waits for room. */
  .service-card__main {
    display: grid;
    grid-template-columns: clamp(6.75rem, 36cqi, 8.5rem) minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-2);
  }

  .service-card__photo {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 8rem;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - var(--space-2));
    background: var(--gradient-icon);
    box-shadow: 0 0 0 3px var(--color-white);
  }

  .service-card__photo :global(.service-card__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }

  .service-card__head {
    display: grid;
    align-content: center;
    padding-block: var(--space-2);
    padding-right: var(--space-2);
  }

  .service-card__head :global(.service-card__icon),
  .service-card__rule {
    display: none;
  }

  .service-card__text {
    display: grid;
    gap: var(--space-2);
  }

  .service-card__title {
    font-size: clamp(1rem, 0.8rem + 1.6cqi, 1.3rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .service-card__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .service-card__summary {
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .service-card__foot {
    display: grid;
    gap: var(--space-3);
    margin-inline: var(--space-4);
    padding-block: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .service-card__info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .service-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .service-card__price {
    color: var(--color-heading);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .service-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  /* Wider cards: the catalog row, with the icon circle and the thin pink rule. */
  @container (min-width: 27rem) {
    .service-card__main {
      grid-template-columns: clamp(8rem, 30cqi, 13.5rem) minmax(0, 1fr);
      gap: var(--space-5);
    }

    .service-card__photo {
      min-height: 9rem;
    }

    .service-card__head {
      grid-template-columns: auto 1px minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-4);
      padding-right: var(--space-4);
    }

    .service-card__head :global(.service-card__icon),
    .service-card__rule {
      display: block;
    }

    .service-card__head :global(.service-card__icon) {
      display: inline-grid;
    }

    .service-card__rule {
      align-self: stretch;
      min-height: 4rem;
      background: linear-gradient(transparent, var(--color-rule) 15% 85%, transparent);
    }
  }

  /* Wide cards: modalities and price on the left, actions on the right. */
  @container (min-width: 36rem) {
    .service-card__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .service-card__actions {
      justify-content: end;
    }
  }

  /* Hover: the card lifts and the photo zooms gently inside its frame. */
  @media (hover: hover) {
    .service-card:hover {
      box-shadow:
        0 0 0 1px rgb(255 36 137 / 0.18),
        var(--shadow-lg);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .service-card:hover {
      transform: translateY(-4px);
    }

    .service-card:hover .service-card__photo :global(.service-card__image) {
      transform: scale(1.06);
    }
  }
</style>
