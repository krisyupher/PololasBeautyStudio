---
import Logo from './Logo.astro';
import UiIcon from './icons/UiIcon.astro';
import { business } from '../data/business';
import { withBase } from '../lib/paths';
import { buildInquiryMessage, buildWhatsAppUrl } from '../lib/whatsapp';

const year = new Date().getFullYear();
const whatsappUrl = buildWhatsAppUrl(buildInquiryMessage());
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="footer" />
      <p>
        {business.bio} {business.slogan}
      </p>
      <ul class="social" role="list">
        <li>
          <a
            href={business.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram (se abre en una pestaña nueva)"
          >
            <UiIcon name="instagram" />
          </a>
        </li>
        <li>
          <a
            href={business.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook (se abre en una pestaña nueva)"
          >
            <UiIcon name="facebook" />
          </a>
        </li>
        <li>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp (se abre en una pestaña nueva)"
          >
            <UiIcon name="whatsapp" />
          </a>
        </li>
      </ul>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="site-footer__title">Explora</h2>
      <ul role="list">
        <li>
          <a href={withBase('/catalogo/')}>Catálogo de tratamientos</a>
        </li>
        <li>
          <a href={withBase('/#como-pedir')}>Cómo hacer tu pedido</a>
        </li>
        <li>
          <a href={withBase('/#modalidades')}>En el estudio o a domicilio</a>
        </li>
        <li>
          <a href={withBase('/#preguntas')}>Preguntas frecuentes</a>
        </li>
        <li>
          <a href={withBase('/privacidad/')}>Política de privacidad</a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">Contacto</h2>
      <ul class="contact-list" role="list">
        <li>
          <UiIcon name="whatsapp" />
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            {business.whatsapp.display}
          </a>
        </li>
        <li>
          <UiIcon name="mail" />
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </li>
        <li>
          <UiIcon name="pin" />
          <span>
            {business.location.neighborhood}, {business.location.city}
          </span>
        </li>
        <li>
          <UiIcon name="clock" />
          <span>{business.hoursNote}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>
      © {year} {business.name}. Hecho con 💜 en {business.location.city}.
    </p>
    <p>
      Los procedimientos de armonización facial requieren valoración previa. Los resultados varían
      según cada persona.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-16);
    background: var(--color-plum-900);
    color: rgb(255 255 255 / 0.85);
  }

  .site-footer a {
    color: var(--color-white);
  }

  .site-footer a:hover {
    color: var(--color-lilac-200);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-10);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
    max-width: 24rem;
  }

  /* The wordmark is drawn for light backgrounds; give it a soft card on the dark footer. */
  .site-footer__brand :global(.logo) {
    justify-self: start;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .site-footer__title {
    margin-bottom: var(--space-4);
    color: var(--color-white);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: var(--space-3);
  }

  .social {
    grid-auto-flow: column;
    justify-content: start;
  }

  .social a {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
  }

  .social a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .social :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .contact-list :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    color: var(--color-lilac-200);
  }

  .site-footer__legal {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-block: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }
</style>
