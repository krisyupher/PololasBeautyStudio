---
import LineIcon from './icons/LineIcon.astro';
import UiIcon from './icons/UiIcon.astro';
import type { UiIconName } from './icons/ui-icons';
import type { IconName } from '../lib/constants';

/** An icon in the catalog's soft pink circle. Decorative: the text next to it carries the meaning. */
interface Props {
  /** A line-art treatment icon (64×64)… */
  line?: IconName;
  /** …or a small interface or value-badge icon (24×24). */
  ui?: UiIconName;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { line, ui, size = 'md', class: className } = Astro.props;
---

<span
  class:list={['icon-circle', `icon-circle--${size}`, { 'icon-circle--ui': !line }, className]}
  aria-hidden="true"
>
  {line ? <LineIcon name={line} strokeWidth={2.6} /> : ui && <UiIcon name={ui} strokeWidth={1.4} />}
</span>

<style>
  .icon-circle {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: var(--icon-circle-size);
    height: var(--icon-circle-size);
    border-radius: 50%;
    background: var(--gradient-icon);
    background-color: var(--color-icon-bg);
    color: var(--color-heading);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 10px 20px -12px rgb(255 36 137 / 0.6);
  }

  .icon-circle--sm {
    --icon-circle-size: 2.5rem;
  }

  .icon-circle--md {
    --icon-circle-size: 3.5rem;
  }

  .icon-circle--lg {
    --icon-circle-size: 4.25rem;
  }

  .icon-circle--xl {
    --icon-circle-size: 5.5rem;
  }

  .icon-circle :global(svg) {
    width: 80%;
    height: 80%;
  }

  .icon-circle--ui :global(svg) {
    width: 52%;
    height: 52%;
  }
</style>
