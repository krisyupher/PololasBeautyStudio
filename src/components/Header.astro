---
import Logo from './Logo.astro';
import UiIcon from './icons/UiIcon.astro';
import { withBase } from '../lib/paths';

const links = [
  { href: withBase('/'), label: 'Inicio' },
  { href: withBase('/catalogo/'), label: 'Catálogo' },
  { href: withBase('/#como-pedir'), label: 'Cómo pedir' },
  { href: withBase('/#modalidades'), label: 'Estudio y domicilio' },
  { href: withBase('/#contacto'), label: 'Contacto' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="site-nav site-nav--desktop" aria-label="Principal">
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="order-button"
        data-open-order
        data-needs-js
        aria-haspopup="dialog"
        aria-controls="order-dialog"
      >
        <UiIcon name="bag" />
        <span>Mi pedido</span>
        <span class="order-badge" data-order-count hidden>
          0
        </span>
      </button>

      <details class="site-nav site-nav--mobile" data-mobile-menu>
        <summary class="icon-button" aria-label="Menú">
          <UiIcon name="menu" />
        </summary>
        <nav aria-label="Menú principal">
          <ul role="list">
            {links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgb(255 36 137 / 0.12);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-2);
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: var(--space-3);
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  /* A short hot-pink rule under the current page, like the catalog's rules. */
  .site-nav--desktop a::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.45rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent-bright);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--ease-out);
  }

  .site-nav--desktop a:hover::after,
  .site-nav--desktop a[aria-current='page']::after {
    opacity: 1;
    transform: none;
  }

  .site-nav--desktop {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .order-button {
    position: relative;
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .order-button:hover {
    border-color: var(--color-accent);
    background: var(--color-lilac-100);
  }

  .order-button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Positioned on the corner so the header doesn't shift when the first item is added. */
  .order-badge {
    position: absolute;
    top: -0.55rem;
    right: -0.55rem;
    display: inline-grid;
    place-items: center;
    box-sizing: content-box;
    min-width: 1.4rem;
    height: 1.4rem;
    padding-inline: 0.35rem;
    border: 2px solid var(--color-white);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .site-nav--mobile {
    position: relative;
  }

  .site-nav--mobile summary {
    list-style: none;
  }

  .site-nav--mobile summary::-webkit-details-marker {
    display: none;
  }

  .site-nav--mobile nav {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    min-width: 15rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
  }

  .site-nav--mobile ul {
    flex-direction: column;
    gap: 0;
  }

  .site-nav--mobile a {
    display: flex;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
  }

  .site-nav--mobile a:hover {
    background: var(--color-lilac-100);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav--mobile[open] nav {
      animation: fade-up 0.35s var(--ease-out);
    }
  }

  @media (min-width: 48rem) {
    .order-button {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .site-nav--desktop {
      display: block;
    }

    .site-nav--mobile {
      display: none;
    }
  }
</style>
