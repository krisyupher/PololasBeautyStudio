---
import { uniqueId } from '../lib/uid';

/**
 * The catalog's layered wave: a light pink band behind a purple → magenta band, then a solid
 * gradient strip that carries white, letter-spaced text (or any slotted content, as in the footer).
 * White text only ever sits on the dark strip, never on the light band.
 */
interface Props {
  text?: string;
  /** Side of the letter-spaced text. */
  align?: 'start' | 'end';
  /** Mirror the wave so it rises to the left. */
  flip?: boolean;
  class?: string;
}

const { text, align = 'end', flip = false, class: className } = Astro.props;
// Several waves can share a page (sections and footer): each needs its own gradient id.
const gradientId = uniqueId('wave-gradient');
---

<div class:list={['wave-band', `wave-band--${align}`, { 'wave-band--flip': flip }, className]}>
  <svg
    class="wave-band__curve"
    viewBox="0 0 1440 140"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1440" y2="0">
        <stop class="wave-band__stop wave-band__stop--1" offset="0"></stop>
        <stop class="wave-band__stop wave-band__stop--2" offset="0.55"></stop>
        <stop class="wave-band__stop wave-band__stop--3" offset="1"></stop>
      </linearGradient>
    </defs>
    <path class="wave-band__back" d="M-60 112C200 140 470 86 760 60 1010 38 1240 30 1500 2V140H-60Z"
    ></path>
    <path
      class="wave-band__front"
      fill={`url(#${gradientId})`}
      d="M-60 140C260 141 560 116 860 90 1100 69 1300 50 1500 26V140H-60Z"></path>
    <path
      class="wave-band__shine"
      d="M-60 140C260 141 560 116 860 90 1100 69 1300 50 1500 26"
      vector-effect="non-scaling-stroke"></path>
  </svg>
  <div class="wave-band__body">
    <div class="container wave-band__content">
      {text && <p class="wave-band__text">{text}</p>}
      <slot />
    </div>
  </div>
</div>

<style>
  .wave-band {
    position: relative;
    color: var(--color-white);
  }

  .wave-band__curve {
    width: 100%;
    height: clamp(3.25rem, 1.6rem + 6vw, 8rem);
    overflow: hidden;
  }

  .wave-band--flip .wave-band__curve {
    scale: -1 1;
  }

  .wave-band__back {
    fill: var(--color-wave-light);
    transform-box: view-box;
  }

  .wave-band__shine {
    fill: none;
    stroke: rgb(255 255 255 / 0.8);
    stroke-width: 2;
  }

  .wave-band__stop--1 {
    stop-color: var(--color-purple-900);
  }

  .wave-band__stop--2 {
    stop-color: var(--color-wave-magenta);
  }

  .wave-band__stop--3 {
    stop-color: var(--color-wave-pink);
  }

  /* Same gradient as the SVG band, so the seam is invisible. Overlaps it by 1px. */
  .wave-band__body {
    margin-top: -1px;
    background: var(--gradient-wave);
    background-color: var(--color-purple-900);
  }

  .wave-band--flip .wave-band__body {
    background: var(--gradient-wave-reverse);
    background-color: var(--color-purple-900);
  }

  .wave-band__content {
    display: grid;
    justify-items: end;
    gap: var(--space-4);
    padding-block: var(--space-1) var(--space-8);
  }

  .wave-band--start .wave-band__content {
    justify-items: start;
  }

  .wave-band__text {
    max-width: 24em;
    color: var(--color-white);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-spaced);
    line-height: 2;
    text-align: end;
    text-transform: uppercase;
  }

  .wave-band--start .wave-band__text {
    text-align: start;
  }

  .wave-band__text::after {
    content: '';
    display: block;
    width: 3.25rem;
    height: 2px;
    margin: var(--space-3) 0 0 auto;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.85);
  }

  .wave-band--start .wave-band__text::after {
    margin-inline: 0 auto;
  }

  /* The back layer drifts subtly. */
  @media (prefers-reduced-motion: no-preference) {
    .wave-band__back {
      animation: wave-drift 16s ease-in-out infinite alternate;
    }
  }

  @keyframes wave-drift {
    from {
      translate: -1.5% 0;
    }

    to {
      translate: 1.5% 0.6%;
    }
  }
</style>
