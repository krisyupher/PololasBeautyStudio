---
import { business } from '../data/business';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title === business.name ? title : `${title} | ${business.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = business.ogImage ? new URL(withBase(business.ogImage), Astro.site) : null;

// JSON-LD is serialized into a <script>; escape "<" so data can never close the tag.
const serialize = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content={business.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={`${business.name}: tu bienestar en buenas manos`} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{jsonLd.map((data) => (
  <script type="application/ld+json" set:html={serialize(data)} />
))}
