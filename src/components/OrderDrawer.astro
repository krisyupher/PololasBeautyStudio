---
import IconCircle from './IconCircle.astro';
import UiIcon from './icons/UiIcon.astro';
import { getServices } from '../lib/catalog';
import { LIMITS } from '../lib/constants';
import { serviceUrl, withBase } from '../lib/paths';

// Suggestions for the empty order, computed at build time from the featured treatments.
const featured = (await getServices()).filter((service) => service.featured);
---

<!-- "Mi pedido": rendered and wired by src/scripts/order-ui.ts. -->
<dialog
  id="order-dialog"
  class="order-dialog"
  aria-labelledby="order-dialog-title"
  data-order-dialog
>
  <div class="order-dialog__panel">
    <header class="order-dialog__header">
      <h2 id="order-dialog-title" class="order-dialog__title" tabindex="-1" data-order-title>
        Mi pedido
      </h2>
      <button type="button" class="icon-button" data-close-order aria-label="Cerrar pedido">
        <UiIcon name="close" />
      </button>
    </header>

    <div class="order-dialog__body">
      <div class="order-empty" data-order-empty>
        <p class="order-empty__title">Tu pedido está vacío</p>
        <p>
          Explora el catálogo y agrega los tratamientos que te interesan. Luego nos lo envías por
          WhatsApp y te confirmamos precio y disponibilidad.
        </p>
        <a class="btn btn--outline btn--sm" href={withBase('/catalogo/')}>
          Ver catálogo
        </a>
        {featured.length > 0 && (
          <div class="order-suggest">
            <h3 class="order-suggest__title">Te puede interesar</h3>
            <ul class="order-suggest__list" role="list">
              {featured.map((service) => (
                <li>
                  <a class="order-suggest__link" href={serviceUrl(service.id)}>
                    <IconCircle line={service.icon} size="sm" />
                    <span>{service.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <ol
        class="order-list"
        role="list"
        aria-label="Tratamientos en tu pedido"
        data-order-list
      ></ol>

      <form class="order-form" data-order-form hidden>
        <fieldset>
          <legend>
            Tus datos <span class="order-form__optional">(opcional)</span>
          </legend>
          <label class="field">
            Nombre
            <input type="text" name="name" autocomplete="name" maxlength={LIMITS.maxShortField} />
          </label>
          <label class="field" data-neighborhood-field hidden>
            Barrio o localidad
            <span class="field__hint">
              Para coordinar el domicilio. La dirección exacta la acordamos por el chat.
            </span>
            <input
              type="text"
              name="neighborhood"
              autocomplete="off"
              maxlength={LIMITS.maxShortField}
            />
          </label>
          <label class="field">
            Fecha y franja preferida
            <input
              type="text"
              name="date"
              placeholder="Ej.: sábado en la tarde"
              maxlength={LIMITS.maxShortField}
            />
          </label>
          <label class="field">
            Comentarios
            <textarea name="comments" rows="3" maxlength={LIMITS.maxComments}></textarea>
          </label>
        </fieldset>
      </form>
    </div>

    <footer class="order-dialog__footer" data-order-footer hidden>
      <p class="order-note">
        Una asesora te confirmará por WhatsApp el precio, la disponibilidad y los detalles. Tus
        datos solo viajan en el mensaje que tú decides enviar (
        <a href={withBase('/privacidad/')}>privacidad</a>).
      </p>
      <a
        class="btn btn--whatsapp btn--block"
        data-send-order
        target="_blank"
        rel="noopener noreferrer"
        aria-disabled="true"
      >
        <UiIcon name="whatsapp" />
        Enviar pedido por WhatsApp
      </a>
      <button type="button" class="btn btn--ghost btn--block" data-clear-order>
        Vaciar pedido
      </button>
    </footer>
  </div>

  <template id="order-item-template">
    <li class="order-item">
      <div class="order-item__head">
        <a class="order-item__name" data-item-link></a>
        <button type="button" class="icon-button" data-item-remove data-focus-key="remove">
          <UiIcon name="trash" />
        </button>
      </div>
      <div class="order-item__controls">
        <fieldset class="segmented" data-item-modalities>
          <legend class="visually-hidden">Modalidad</legend>
        </fieldset>
        <div class="stepper" role="group" data-item-people>
          <button type="button" class="stepper__btn" data-people-dec data-focus-key="dec">
            <UiIcon name="minus" />
          </button>
          <span class="stepper__value" data-people-value></span>
          <button type="button" class="stepper__btn" data-people-inc data-focus-key="inc">
            <UiIcon name="plus" />
          </button>
        </div>
      </div>
    </li>
  </template>
</dialog>

<style>
  .order-dialog {
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .order-dialog::backdrop {
    background: rgb(74 0 74 / 0.5);
  }

  :global(html:has(.order-dialog[open])) {
    overflow: hidden;
  }

  .order-dialog__panel {
    position: fixed;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    max-height: 92dvh;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-dialog[open] .order-dialog__panel {
      animation: slide-up 0.3s var(--ease-out);
    }
  }

  @keyframes slide-up {
    from {
      transform: translateY(24px);
      opacity: 0;
    }
  }

  .order-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .order-dialog__title {
    color: var(--color-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    text-transform: uppercase;
  }

  .order-dialog__title:focus {
    outline: none;
  }

  .order-dialog__body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-5);
  }

  .order-empty {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    color: var(--color-text-muted);
  }

  .order-empty__title {
    color: var(--color-heading);
    font-weight: 700;
  }

  .order-suggest {
    justify-self: stretch;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .order-suggest__title {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .order-suggest__list {
    display: grid;
    gap: var(--space-1);
  }

  .order-suggest__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .order-suggest__link:hover {
    background: var(--color-lilac-100);
    color: var(--color-heading);
  }

  .order-list {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .order-item {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }

  .order-item__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .order-item__name {
    padding-top: var(--space-2);
    color: var(--color-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .order-item__name:hover {
    text-decoration: underline;
  }

  .order-item__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .segmented {
    display: inline-flex;
    margin: 0;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-white);
  }

  .segmented :global(label) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .segmented :global(input) {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .segmented :global(label:has(input:checked)) {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .segmented :global(label:has(input:focus-visible)) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .segmented :global(.segmented__single) {
    padding: 0.35rem var(--space-3);
    color: var(--color-heading);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .stepper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .stepper__btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
  }

  .stepper__btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .stepper__btn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .stepper__value {
    min-width: 5.5rem;
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }

  .order-form fieldset {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .order-form legend {
    margin-bottom: var(--space-3);
    color: var(--color-heading);
    font-weight: 800;
    text-transform: uppercase;
  }

  .order-form__optional {
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: none;
  }

  .order-dialog__footer {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) max(var(--space-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
  }

  .order-note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .order-dialog__panel {
      inset: 0 0 0 auto;
      width: min(30rem, 100%);
      max-height: none;
      border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    }

    @media (prefers-reduced-motion: no-preference) {
      .order-dialog[open] .order-dialog__panel {
        animation-name: slide-in;
      }
    }
  }

  @keyframes slide-in {
    from {
      transform: translateX(32px);
      opacity: 0;
    }
  }
</style>
