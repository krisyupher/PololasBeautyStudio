---
/**
 * The catalog's large, soft three-petal clusters, placed at a section corner. Decorative.
 * The section needs the `petal-host` class: petals sit behind its content and are clipped.
 */
interface Props {
  position: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { position, size = 'md', class: className } = Astro.props;
// Petals grow from a shared base at (100, 188); the side petals are the same leaf, tilted.
const centerPetal = 'M100 188C146 126.8 123 52 100 18 77 52 54 126.8 100 188Z';
const sidePetal = 'M100 188C140 136.88 120 74.4 100 46 80 74.4 60 136.88 100 188Z';
---

<svg
  class:list={['petals', `petals--${position}`, `petals--${size}`, className]}
  viewBox="0 0 200 200"
  aria-hidden="true"
  focusable="false"
>
  <g class="petals__petal petals__petal--left">
    <path d={sidePetal} transform="rotate(-40 100 188)"></path>
  </g>
  <g class="petals__petal petals__petal--right">
    <path d={sidePetal} transform="rotate(40 100 188)"></path>
  </g>
  <g class="petals__petal petals__petal--center">
    <path d={centerPetal}></path>
  </g>
</svg>

<style>
  .petals {
    position: absolute;
    z-index: -1;
    width: var(--petals-size);
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  .petals--sm {
    --petals-size: clamp(5.5rem, 3.5rem + 8vw, 9rem);
  }

  .petals--md {
    --petals-size: clamp(7.5rem, 4.5rem + 11vw, 14rem);
  }

  .petals--lg {
    --petals-size: clamp(9rem, 5rem + 16vw, 19rem);
  }

  /* Each corner turns the cluster so the petals fan in towards the content. */
  .petals--bottom-left {
    bottom: calc(var(--petals-size) * -0.22);
    left: calc(var(--petals-size) * -0.3);
    rotate: 34deg;
  }

  .petals--bottom-right {
    right: calc(var(--petals-size) * -0.3);
    bottom: calc(var(--petals-size) * -0.22);
    rotate: -34deg;
  }

  .petals--top-left {
    top: calc(var(--petals-size) * -0.22);
    left: calc(var(--petals-size) * -0.3);
    rotate: 146deg;
  }

  .petals--top-right {
    top: calc(var(--petals-size) * -0.22);
    right: calc(var(--petals-size) * -0.3);
    rotate: -146deg;
  }

  .petals__petal {
    fill: var(--color-petal);
    transform-box: view-box;
    transform-origin: 50% 94%;
  }

  .petals__petal--left {
    fill: var(--color-petal-deep);
    opacity: 0.8;
  }

  .petals__petal--right {
    opacity: 0.75;
  }

  .petals__petal--center {
    opacity: 0.9;
  }

  /*
   * Drift and sway once, out and back, each petal on its own clock. Kept under
   * five seconds so the motion needs no pause control (WCAG 2.2.2).
   */
  @media (prefers-reduced-motion: no-preference) {
    .petals {
      animation: petals-drift 2.5s ease-in-out 2 alternate;
    }

    .petals--top-left,
    .petals--bottom-right {
      animation-duration: 2.2s;
    }

    .petals__petal {
      animation: petal-sway 2.4s ease-in-out 2 alternate both;
    }

    .petals__petal--right {
      animation-duration: 2.1s;
      animation-delay: 0.3s;
    }

    .petals__petal--center {
      animation-duration: 1.9s;
      animation-delay: 0.6s;
    }
  }

  @keyframes petals-drift {
    from {
      translate: 0 0;
    }

    to {
      translate: 0.6rem 0.9rem;
    }
  }

  @keyframes petal-sway {
    from {
      rotate: -3deg;
    }

    to {
      rotate: 4deg;
    }
  }
</style>
