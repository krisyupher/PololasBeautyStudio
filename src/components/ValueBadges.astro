---
import IconCircle from './IconCircle.astro';
import type { ValueIconName } from '../lib/constants';

/** The four value badges at the foot of each catalog page, separated by thin pink rules. */
interface Props {
  values: readonly { icon: ValueIconName; label: string }[];
  class?: string;
}

const { values, class: className } = Astro.props;
---

<ul class:list={['value-badges', className]} role="list">
  {values.map((value) => (
    <li class="value-badge">
      <IconCircle ui={value.icon} size="lg" class="value-badge__icon" />
      <span class="value-badge__label">{value.label}</span>
    </li>
  ))}
</ul>

<style>
  /* Phones: a compact 2×2 list, small icon left and label right, no rules. */
  .value-badges {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
  }

  .value-badge {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .value-badge :global(.value-badge__icon) {
    --icon-circle-size: 2.75rem;
  }

  /* Very small phones (under 360px): one badge per row, so long words fit. */
  @media (max-width: 22.49rem) {
    .value-badges {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .value-badge__label {
    min-width: 0;
    overflow-wrap: break-word;
    max-width: 12rem;
    color: var(--color-heading);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* From tablets: the catalog row, icon above label, thin pink rules between columns. */
  @media (min-width: 48rem) {
    .value-badges {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .value-badge {
      display: grid;
      justify-items: center;
      align-content: start;
      gap: var(--space-3);
      padding-inline: var(--space-3);
      text-align: center;
    }

    .value-badge :global(.value-badge__icon) {
      --icon-circle-size: 4.25rem;
    }

    .value-badge__label {
      font-size: var(--text-xs);
    }

    .value-badge:not(:first-child)::before {
      content: '';
      position: absolute;
      inset: 8% auto 8% 0;
      width: 1px;
      background: linear-gradient(transparent, var(--color-rule) 18% 82%, transparent);
    }
  }

  /* The icon circles pop in, one after another, as the row scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .value-badges {
        view-timeline-name: --value-badges;
      }

      .value-badge :global(.value-badge__icon) {
        animation-name: pop-in;
        animation-duration: auto;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: --value-badges;
        animation-range: entry 10% cover 30%;
      }

      .value-badge:nth-child(2) :global(.value-badge__icon) {
        animation-range: entry 30% cover 34%;
      }

      .value-badge:nth-child(3) :global(.value-badge__icon) {
        animation-range: entry 50% cover 38%;
      }

      .value-badge:nth-child(4) :global(.value-badge__icon) {
        animation-range: entry 70% cover 42%;
      }

      .value-badge__label {
        animation-name: fade-in;
        animation-duration: auto;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: --value-badges;
        animation-range: entry 30% cover 40%;
      }
    }
  }
</style>
