---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import { getLogoImage, getLogoWhiteImage } from '../lib/images';
import { withBase } from '../lib/paths';

interface Props {
  variant?: 'header' | 'footer';
  /** "white" uses src/assets/brand/logo-white.png, for purple backgrounds. */
  tone?: 'color' | 'white';
}

const { variant = 'header', tone = 'color' } = Astro.props;
const logo = tone === 'white' ? (getLogoWhiteImage() ?? getLogoImage()) : getLogoImage();
const height = variant === 'header' ? 52 : 84;
---

<a
  class:list={['logo', `logo--${variant}`, `logo--${tone}`]}
  href={withBase('/')}
  aria-label={`${business.name}, ir al inicio`}
>
  {logo ? (
    <Image src={logo} alt="" class="logo__image" height={height} densities={[1, 2]} />
  ) : (
    <Fragment>
      <span class="logo__mark" aria-hidden="true">
        P
      </span>
      <span class="logo__text" aria-hidden="true">
        <span class="logo__script">Pololas</span>
        <span class="logo__caption">Beauty Studio</span>
      </span>
    </Fragment>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    text-decoration: none;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding-top: 0.3rem;
    border-radius: 50%;
    background: var(--color-icon-bg);
    color: var(--color-primary);
    font-family: var(--font-script);
    font-size: 2.2rem;
    line-height: 1;
  }

  .logo__text {
    display: grid;
    line-height: 1;
  }

  .logo__script {
    padding-right: 0.15em;
    color: var(--color-primary);
    font-family: var(--font-script);
    font-size: 2.4rem;
  }

  .logo__caption {
    margin-top: -0.1rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid currentColor;
    color: var(--color-text-muted);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .logo--white,
  .logo--white .logo__script,
  .logo--white .logo__caption {
    color: var(--color-white);
  }

  .logo--white .logo__mark {
    background: rgb(255 255 255 / 0.15);
    color: var(--color-white);
  }

  .logo :global(.logo__image) {
    width: auto;
  }

  .logo--header :global(.logo__image) {
    height: 44px;
  }

  .logo--footer :global(.logo__image) {
    height: 72px;
  }

  @media (min-width: 48rem) {
    .logo--header :global(.logo__image) {
      height: 52px;
    }

    .logo--footer :global(.logo__image) {
      height: 84px;
    }
  }
</style>
