---
/** The catalog's hand-drawn outline heart. Decorative; parents size and animate it. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['heart', className]}
  viewBox="0 0 48 44"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M23 38C13.6 31.4 5.8 24.4 5.1 16.2 4.6 9.9 8.6 5.7 13.7 5.8c4.5.1 8 3.3 10.2 7.6 2.3-4.4 5.9-7.5 10.4-7.5 5.2.1 9 4.5 8.2 10.9-1 8-9.4 15-19.6 22.6"></path>
</svg>

<style>
  .heart {
    color: var(--color-heart-line);
    overflow: visible;
  }
</style>
