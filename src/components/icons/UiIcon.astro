---
import { FILLED_UI_ICONS, UI_ICONS, type UiIconName } from './ui-icons';

interface Props {
  name: UiIconName;
  class?: string;
  /** Line weight in viewBox units (the viewBox is 24×24). */
  strokeWidth?: number;
}

const { name, class: className, strokeWidth = 1.8 } = Astro.props;
const filled = FILLED_UI_ICONS.has(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {UI_ICONS[name].map((d) => (
    <path d={d} />
  ))}
</svg>
